{
  "name": "foto-fight",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "generate-assets": "node scripts/generate-assets.js",
    "build:android": "eas build --platform android --profile production",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:dev": "eas build --platform android --profile development",
    "copy-model": "powershell -ExecutionPolicy Bypass -File scripts/copy-model-to-android.ps1",
    "build:android:local": "npx expo prebuild --platform android && npm run copy-model && npx expo run:android",
    "build:android:apk:debug": "npx expo export:embed --platform android && npx expo prebuild --platform android && npm run copy-model && cd android && gradlew.bat assembleDebug && cd ..",
    "build:android:apk:release": "npx expo prebuild --platform android && npm run copy-model && cd android && gradlew.bat assembleRelease && cd ..",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "logs:android": "powershell -ExecutionPolicy Bypass -File scripts/view-android-logs.ps1",
    "clean:gradle": "cd android && gradlew.bat clean && cd ..",
    "clean:gradle:cache": "powershell -ExecutionPolicy Bypass -File scripts/clean-gradle-cache.ps1",
    "clean:android": "npx expo prebuild --clean --platform android",
    "clean:all": "npm run clean:gradle:cache && npm run clean:android && powershell -Command \"Remove-Item -Recurse -Force -ErrorAction SilentlyContinue .\\android\\build, .\\android\\app\\build, .\\.expo, .\\node_modules\\.cache\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.0.4",
    "@supabase/supabase-js": "2.90.1",
    "base64-arraybuffer": "1.0.2",
    "expo": "~51.0.0",
    "expo-auth-session": "~5.5.2",
    "expo-brightness": "~12.0.1",
    "expo-build-properties": "~0.12.5",
    "expo-camera": "~15.0.16",
    "expo-clipboard": "~6.0.3",
    "expo-constants": "~16.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-gl": "~14.0.2",
    "expo-image-manipulator": "~12.0.5",
    "expo-image-picker": "~15.1.0",
    "expo-linking": "~6.3.1",
    "expo-location": "~17.0.1",
    "expo-router": "~3.5.24",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "expo-web-browser": "~13.0.3",
    "jpeg-js": "0.4.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-fast-tflite": "2.0.0",
    "@react-native-picker/picker": "2.7.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-web": "^0.19.12",
    "typescript": "~5.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.79",
    "sharp": "0.34.5"
  },
  "private": true
}